@page "/bookdetail/{BookIdValue:int}"
@using ShortBox.Api.Data
@using ShortBox.Communication

@inject IShortBoxReaderClient client

<h3>@Book?.Series @Book?.Number</h3>

<table>
    <tr>
        <th>Id</th>
        <td>@Book?.Id</td>
    </tr>
    <tr>
        <th>Added</th>
        <td>@Book?.Added</td>
    </tr>
    <tr>
        <th>Modified</th>
        <td>@Book?.Modified</td>
    </tr>
    <tr>
        <th>File Name</th>
        <td>@Book?.FileName</td>
    </tr>
    <tr>
        <th>Page Count</th>
        <td>@Book?.PageCount</td>
    </tr>
    <tr>
        <th>Current Page</th>
        <td>@Book?.CurrentPage</td>
    </tr>
</table>

<button @onclick="()=>PreviousPage()">-</button>
<button @onclick="()=>NextPage()">+</button>
<p>Page @CurrentPage / @Book?.PageCount </p>

<br />

<img src="@PageData" width="1024" />

@code {
    [Parameter]
    public int? BookIdValue { get; set; }

    private Book? Book { get; set; }

    private int CurrentPage { get; set; }

    private string? PageData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (BookIdValue.HasValue)
        {
            Book = await client.GetBookAsync(BookIdValue.Value, CancellationToken.None).ConfigureAwait(false);
            await LoadPageAsync(CancellationToken.None).ConfigureAwait(false);
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 0)
        {
            CurrentPage--;
            await LoadPageAsync(CancellationToken.None).ConfigureAwait(false);
        }
    }

    private async Task NextPage()
    {
        if (Book?.PageCount is int pageCount && CurrentPage < pageCount)
        {
            CurrentPage++;
            await LoadPageAsync(CancellationToken.None).ConfigureAwait(false);
        }
    }

    private async Task LoadPageAsync(CancellationToken cancellationToken)
    {
        if (this.BookIdValue is int id)
        {
            var pageStream = await client.GetBookPageAsync(id, CurrentPage, cancellationToken).ConfigureAwait(false);
            PageData = await pageStream.ReadBase64ImageDataAsync(cancellationToken).ConfigureAwait(false);
        }
    }
}
